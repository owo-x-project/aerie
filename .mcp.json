{
  "mcpServers": {
    "lean-ctx": {
      "type": "stdio",
      "command": "nix",
      "env": {
        "LEAN_CTX_HEADLESS": "1",
        "LEAN_CTX_RULES_INJECTION": "dedicated"
      },
      "args": [
        "develop",
        "--no-write-lock-file",
        "path:.",
        "--command",
        "lean-ctx"
      ]
    },
    "owlgrowth": {
      "type": "stdio",
      "command": "./projects/owlgrowth/bin/owlgrowth-mcp",
      "args": []
    },
    "owlknowledge": {
      "type": "stdio",
      "command": "./projects/owlknowledge/bin/owlknowledge-mcp",
      "args": []
    }
  }
}
