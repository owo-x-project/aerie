{
  "mcpServers": {
    "lean-ctx": {
      "type": "stdio",
      "command": "nix",
      "env": {
        "LEAN_CTX_HEADLESS": "1",
        "LEAN_CTX_RULES_INJECTION": "dedicated"
      },
      "args": [
        "develop",
        "--no-write-lock-file",
        "path:.",
        "--command",
        "lean-ctx"
      ]
    }
  }
}
