# APM rebuilds its dependency cache from the lockfile.
apm_modules/

# Nix-generated links and direnv state.
result
result-*
.direnv/

# LeanCTX cognition state is local and derived. Do not commit session/cache data.
.state/
.lean-ctx/

# OS and editor noise.
.DS_Store
*.swp

# This repository is a template, so it must not hand a new Workspace another
# one's work. A tracked .beads/ would carry this project's issue history and its
# Beads project identity into every Workspace generated from it, so the store
# stays local and `bd init --skip-agents` creates a fresh one per clone.
# A Project that is not a template should track its own .beads/ instead.
.beads/
.dolt/
*.db
.beads-credential-key

# Local handoff input. Keep the explanation, but do not commit materials placed
# in the inbox itself.
/inbox/*
!/inbox/README.md
