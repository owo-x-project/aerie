# Repository composition is intentionally empty until projects are onboarded.
# Add repositories using the vcs2l schema, for example:
#
# repositories:
#   project-name:
#     type: git
#     url: https://example.invalid/project-name.git
#     version: main
repositories:
  owlgrowth:
    type: git
    url: https://github.com/owo-x-project/owlgrowth.git
    version: main
  owlknowledge:
    type: git
    url: https://github.com/owo-x-project/owlknowledge.git
    version: main
